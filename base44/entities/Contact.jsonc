{
  "name": "Contact",
  "type": "object",
  "properties": {
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "is_primary": {
      "type": "boolean"
    },
    "is_decision_maker": {
      "type": "boolean"
    },
    "dnd_flag": {
      "type": "boolean",
      "default": false
    },
    "consent_voice": {
      "type": "boolean",
      "default": false
    },
    "consent_whatsapp": {
      "type": "boolean",
      "default": false
    },
    "consent_email": {
      "type": "boolean",
      "default": false
    },
    "consent_captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "English",
        "Hindi",
        "Hinglish",
        "Tamil",
        "Telugu",
        "Marathi"
      ],
      "default": "Hindi"
    }
  },
  "required": [
    "full_name"
  ]
}