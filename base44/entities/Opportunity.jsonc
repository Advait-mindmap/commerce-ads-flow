{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string"
    },
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "package_code": {
      "type": "string"
    },
    "package_name": {
      "type": "string"
    },
    "monthly_budget": {
      "type": "number"
    },
    "contract_months": {
      "type": "number"
    },
    "total_value": {
      "type": "number"
    },
    "stage": {
      "type": "string",
      "enum": [
        "proposed",
        "negotiating",
        "verbal",
        "won",
        "lost"
      ]
    },
    "close_probability": {
      "type": "number"
    },
    "expected_close_date": {
      "type": "string",
      "format": "date"
    },
    "days_in_stage": {
      "type": "number"
    },
    "owner_rep_name": {
      "type": "string"
    },
    "projected_roas_low": {
      "type": "number"
    },
    "projected_roas_high": {
      "type": "number"
    },
    "lost_reason": {
      "type": "string"
    },
    "proposal_status": {
      "type": "string",
      "enum": [
        "none",
        "draft",
        "sent",
        "viewed",
        "signed",
        "expired"
      ]
    },
    "proposal_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "proposal_viewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "proposal_view_count": {
      "type": "number"
    },
    "contract_start_date": {
      "type": "string",
      "format": "date"
    },
    "contract_end_date": {
      "type": "string",
      "format": "date"
    },
    "renewal_date": {
      "type": "string",
      "format": "date"
    },
    "renewal_risk": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    }
  },
  "required": [
    "seller_name"
  ]
}