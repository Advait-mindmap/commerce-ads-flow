{
  "name": "Lead",
  "type": "object",
  "properties": {
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "contact_id": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "google_ads",
        "meta_ads",
        "dashboard_signal",
        "dashboard_form",
        "outbound_list",
        "inbound_call",
        "referral",
        "webinar"
      ]
    },
    "source_campaign": {
      "type": "string"
    },
    "mql_trigger": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "raw",
        "mql",
        "sql",
        "opportunity",
        "won",
        "lost",
        "nurture",
        "disqualified"
      ]
    },
    "mql_at": {
      "type": "string",
      "format": "date-time"
    },
    "sql_at": {
      "type": "string",
      "format": "date-time"
    },
    "pta_score": {
      "type": "number"
    },
    "pta_band": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "pta_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget_low": {
      "type": "number"
    },
    "budget_target": {
      "type": "number"
    },
    "budget_stretch": {
      "type": "number"
    },
    "assigned_rep_name": {
      "type": "string"
    },
    "assigned_at": {
      "type": "string",
      "format": "date-time"
    },
    "sla_due_at": {
      "type": "string",
      "format": "date-time"
    },
    "sla_status": {
      "type": "string",
      "enum": [
        "on_track",
        "at_risk",
        "breached",
        "met"
      ]
    },
    "agent_attempts": {
      "type": "number",
      "default": 0
    },
    "last_agent_contact_at": {
      "type": "string",
      "format": "date-time"
    },
    "agent_disposition": {
      "type": "string"
    },
    "suggested_opening_line": {
      "type": "string"
    },
    "meeting_scheduled_at": {
      "type": "string",
      "format": "date-time"
    },
    "meeting_status": {
      "type": "string",
      "enum": [
        "none",
        "booked",
        "confirmed",
        "rescheduled",
        "no_show",
        "completed",
        "cancelled"
      ]
    },
    "meeting_rep": {
      "type": "string"
    },
    "meeting_booked_by": {
      "type": "string",
      "enum": [
        "agent",
        "human"
      ]
    },
    "handoff_reason": {
      "type": "string"
    },
    "suppression_status": {
      "type": "string",
      "enum": [
        "none",
        "dnd",
        "frequency_cap",
        "recent_contact",
        "opted_out"
      ]
    },
    "disqualify_reason": {
      "type": "string"
    },
    "experiment_assignments": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "seller_name"
  ]
}