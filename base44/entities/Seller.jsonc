{
  "name": "Seller",
  "type": "object",
  "properties": {
    "external_seller_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "legal_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "Fashion",
        "Electronics",
        "Home & Decor",
        "Beauty",
        "Grocery",
        "Toys",
        "Sports",
        "Books",
        "Automotive",
        "Health"
      ]
    },
    "seller_type": {
      "type": "string",
      "enum": [
        "brand",
        "reseller",
        "manufacturer",
        "agency_managed"
      ]
    },
    "tier": {
      "type": "string",
      "enum": [
        "platinum",
        "gold",
        "silver",
        "bronze",
        "new"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "churned",
        "dormant"
      ],
      "default": "active"
    },
    "city": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "onboarded_at": {
      "type": "string",
      "format": "date"
    },
    "tenure_days": {
      "type": "number"
    },
    "gmv_30d": {
      "type": "number"
    },
    "gmv_90d": {
      "type": "number"
    },
    "gmv_growth_30": {
      "type": "number"
    },
    "aov": {
      "type": "number"
    },
    "return_rate": {
      "type": "number"
    },
    "sku_count": {
      "type": "number"
    },
    "sku_added_30d": {
      "type": "number"
    },
    "listing_quality": {
      "type": "number"
    },
    "organic_impr_30d": {
      "type": "number"
    },
    "organic_impr_decline": {
      "type": "number"
    },
    "organic_ctr": {
      "type": "number"
    },
    "avg_position": {
      "type": "number"
    },
    "position_loss_90d": {
      "type": "number"
    },
    "category_sov": {
      "type": "number"
    },
    "zero_impression_sku_pct": {
      "type": "number"
    },
    "ad_page_views_30d": {
      "type": "number"
    },
    "setup_abandons_30d": {
      "type": "number"
    },
    "days_since_ad_page_view": {
      "type": "number"
    },
    "ever_advertised": {
      "type": "boolean"
    },
    "lifetime_ad_spend": {
      "type": "number"
    },
    "last_campaign_roas": {
      "type": "number"
    },
    "pta_score": {
      "type": "number"
    },
    "pta_band": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "pta_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pta_contributions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "feature": {
            "type": "string"
          },
          "contribution": {
            "type": "number"
          }
        }
      }
    },
    "budget_low": {
      "type": "number"
    },
    "budget_target": {
      "type": "number"
    },
    "budget_stretch": {
      "type": "number"
    },
    "traffic_series": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "week": {
            "type": "string"
          },
          "organic": {
            "type": "number"
          },
          "gmv": {
            "type": "number"
          },
          "ad_impr": {
            "type": "number"
          }
        }
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "signal_type": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "severity": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "occurred_at": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "display_name",
    "category"
  ]
}