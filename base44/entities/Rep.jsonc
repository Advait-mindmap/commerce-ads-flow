{
  "name": "Rep",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "initials": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "capacity": {
      "type": "number",
      "default": 40
    },
    "current_load": {
      "type": "number"
    },
    "close_rate_a_band": {
      "type": "number"
    },
    "close_rate_b_band": {
      "type": "number"
    },
    "meetings_this_week": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "on_call",
        "offline"
      ]
    }
  },
  "required": [
    "name"
  ]
}