{
  "name": "AgentRun",
  "type": "object",
  "properties": {
    "agent_key": {
      "type": "string",
      "enum": [
        "enrichment",
        "nurture",
        "sdr_qualification",
        "package_recommender",
        "optimizer",
        "renewal"
      ]
    },
    "lead_id": {
      "type": "string"
    },
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "voice_out",
        "voice_in",
        "whatsapp",
        "email",
        "system"
      ]
    },
    "bolna_call_id": {
      "type": "string"
    },
    "call_status": {
      "type": "string"
    },
    "signature_verified": {
      "type": "boolean"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "in_progress",
        "completed",
        "escalated",
        "failed",
        "no_answer",
        "busy"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "duration_sec": {
      "type": "number"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "qualified",
        "not_qualified",
        "callback_requested",
        "meeting_booked",
        "no_answer",
        "escalated",
        "opted_out"
      ]
    },
    "script_variant": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "cost_usd": {
      "type": "number"
    },
    "recording_url": {
      "type": "string"
    },
    "transcript": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "timestamp_sec": {
            "type": "number"
          },
          "sentiment": {
            "type": "number"
          }
        }
      }
    },
    "transcript_summary": {
      "type": "string"
    },
    "talk_ratio": {
      "type": "number"
    },
    "overall_sentiment": {
      "type": "number"
    },
    "qualification": {
      "type": "object",
      "properties": {
        "is_decision_maker": {
          "type": "boolean"
        },
        "decision_maker_name": {
          "type": "string"
        },
        "currently_advertising": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budget_band_stated": {
          "type": "string"
        },
        "timeline": {
          "type": "string"
        },
        "pain_confirmed": {
          "type": "boolean"
        },
        "pain_description": {
          "type": "string"
        },
        "qualified": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number"
        },
        "fields_needing_verification": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "objections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "objection_type": {
            "type": "string"
          },
          "verbatim": {
            "type": "string"
          },
          "agent_response": {
            "type": "string"
          },
          "resolved": {
            "type": "boolean"
          },
          "at_sec": {
            "type": "number"
          }
        }
      }
    },
    "guardrail_events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at_sec": {
            "type": "number"
          },
          "type": {
            "type": "string"
          },
          "trigger_verbatim": {
            "type": "string"
          },
          "action": {
            "type": "string"
          }
        }
      }
    },
    "escalation": {
      "type": "object",
      "properties": {
        "triggered": {
          "type": "boolean"
        },
        "trigger_type": {
          "type": "string"
        },
        "trigger_verbatim": {
          "type": "string"
        },
        "at_sec": {
          "type": "number"
        },
        "assigned_rep": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "resolution": {
          "type": "string"
        }
      }
    }
  },
  "required": []
}