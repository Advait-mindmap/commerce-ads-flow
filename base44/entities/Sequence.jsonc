{
  "name": "Sequence",
  "type": "object",
  "properties": {
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "lead_id": {
      "type": "string"
    },
    "sequence_type": {
      "type": "string",
      "enum": [
        "nurture",
        "winback",
        "onboarding",
        "renewal",
        "reengagement"
      ]
    },
    "channel": {
      "type": "string",
      "enum": [
        "email",
        "whatsapp",
        "dashboard"
      ]
    },
    "step_number": {
      "type": "number"
    },
    "total_steps": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "stopped_replied",
        "stopped_converted",
        "stopped_optout"
      ]
    },
    "variant": {
      "type": "string"
    },
    "last_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_send_at": {
      "type": "string",
      "format": "date-time"
    },
    "opens": {
      "type": "number"
    },
    "clicks": {
      "type": "number"
    },
    "replied": {
      "type": "boolean"
    }
  }
}