{
  "name": "ModelVersion",
  "type": "object",
  "properties": {
    "model_key": {
      "type": "string",
      "enum": [
        "pta",
        "budget_capacity",
        "churn_survival",
        "elasticity"
      ]
    },
    "version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "champion",
        "challenger",
        "retired"
      ]
    },
    "auc": {
      "type": "number"
    },
    "average_precision": {
      "type": "number"
    },
    "calibration_error": {
      "type": "number"
    },
    "trained_at": {
      "type": "string",
      "format": "date-time"
    },
    "training_rows": {
      "type": "number"
    },
    "feature_importances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "feature": {
            "type": "string"
          },
          "importance": {
            "type": "number"
          }
        }
      }
    },
    "calibration_curve": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "predicted": {
            "type": "number"
          },
          "actual": {
            "type": "number"
          }
        }
      }
    },
    "drift_psi_by_feature": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "feature": {
            "type": "string"
          },
          "psi": {
            "type": "number"
          }
        }
      }
    },
    "drift_psi_max": {
      "type": "number"
    },
    "drift_status": {
      "type": "string",
      "enum": [
        "stable",
        "watch",
        "drifted"
      ]
    }
  },
  "required": [
    "version"
  ]
}