{
  "name": "Interaction",
  "type": "object",
  "properties": {
    "seller_id": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "lead_id": {
      "type": "string"
    },
    "agent_run_id": {
      "type": "string"
    },
    "channel": {
      "type": "string",
      "enum": [
        "voice_out",
        "voice_in",
        "whatsapp",
        "email",
        "dashboard",
        "video_call"
      ]
    },
    "actor_type": {
      "type": "string",
      "enum": [
        "agent",
        "human_rep",
        "system"
      ]
    },
    "actor_name": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound"
      ]
    },
    "outcome": {
      "type": "string"
    },
    "disposition": {
      "type": "string"
    },
    "duration_sec": {
      "type": "number"
    },
    "sentiment_score": {
      "type": "number"
    },
    "summary": {
      "type": "string"
    },
    "objections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "seller_name",
    "started_at"
  ]
}